# ==============================================================================
# Staging Environment Configuration (settings/envs/staging.env)
# ==============================================================================
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (Staging Cluster / Managed RDS)
DB_HOST=staging-db.internal
DB_PORT=5432
DB_NAME=nyc_taxi_staging
DB_USER=taxi_staging_user
DB_PASSWORD=staging_secure_pass
DB_SSLMODE=prefer
DB_POOL_SIZE=20

# Parameterized Directories & Paths
PATH_DATA_ROOT_DIR=/var/data/nyc_taxi/staging
PATH_RAW_DATA_DIR=/var/data/nyc_taxi/staging/raw
PATH_PROCESSED_DATA_DIR=/var/data/nyc_taxi/staging/processed
PATH_STAGING_DATA_DIR=/var/data/nyc_taxi/staging/temp
PATH_LOG_DIR=/var/log/nyc_taxi/staging
PATH_SQL_DIR=sql

# SQL File Parameterization
PATH_SCHEMA_DDL_FILENAME=01_schema.sql
PATH_ANALYTICS_QUERIES_FILENAME=02_analytics_queries.sql

# Log File Parameterization
PATH_METRICS_LOG_FILENAME=etl_metrics.jsonl
PATH_APP_LOG_FILENAME=app.log

# TLC CloudFront Remote URLs & Templates (Manual Override Available)
RAW_DATA_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
PATH_TLC_TRIP_DATA_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
PATH_TLC_MISC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/misc
PATH_TAXI_ZONE_LOOKUP_FILENAME=taxi_zone_lookup.csv
PATH_YELLOW_TRIPDATA_FILENAME_TEMPLATE=yellow_tripdata_{month}.parquet

# Pipeline Ingestion & Warehouse Recovery Range
START_MONTH=2023-01
END_MONTH=2023-04

# Exact Date Filtering (Optional: YYYY-MM-DD)
START_DATE=
END_DATE=

# Batch Chunking & Slicing (1 to 10 then finish, 11 to 20 then finish)
DAY_CHUNK_SIZE=10
BATCH_CHUNK_SIZE=250000

# Slack Alerting Configuration (Insert your Slack Incoming Webhook URL)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_SECRET_TOKEN
SLACK_CHANNEL=#nyc-alerts
SLACK_ALERTS_ENABLED=true
SLACK_ALERT_ON_FAILURE=true
SLACK_ALERT_ON_RETRY=true
SLACK_ALERT_ON_SUCCESS=true
SLACK_ALERT_ON_SLA_MISS=true
SLACK_ALERT_ON_QUARANTINE=true
SLACK_QUARANTINE_ALERT_THRESHOLD_PCT=5.0